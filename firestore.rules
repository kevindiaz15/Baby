rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "polsion155@gmail.com";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isGuestReservation() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["reservedBy", "reservedByUid", "reservedAt"])
        && resource.data.reservedByUid == null
        && request.resource.data.reservedBy is string
        && request.resource.data.reservedBy.size() <= 40
        && request.resource.data.reservedByUid == request.auth.uid
        && request.resource.data.reservedAt == request.time;
    }

    match /gifts/{giftId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.order is int;

      allow update: if isAdmin() || isGuestReservation();

      allow delete: if isAdmin();
    }
  }
}
